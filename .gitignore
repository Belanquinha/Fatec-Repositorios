# Opencode plugin runtime (only .opencode/commands/ is versioned;
# the manifest + dependencies are local — see .opencode/.gitignore)
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock

# Segredos do back-end (POSTGRES_PASSWORD, JWT_SECRET). `.env` na raiz é lido
# pelo docker compose; nunca versionar. O molde versionado é `.env.example`.
.env
.env.*
!.env.example

# Build outputs (redundância proposital: cada subprojeto tem seu .gitignore;
# estas regras cobrem qualquer nível)
node_modules/
dist/
target/
.angular/
coverage/

# Insumos one-shot já consolidados em back-end/src/main/resources/seeds/
exportacao_*.csv
 