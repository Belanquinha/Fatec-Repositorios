# Copie este arquivo para `.env` e preencha os valores:
#   cp .env.example .env
#
# Apenas variáveis com prefixo NG_APP_ são expostas ao build Angular.
# Nenhum destes valores é segredo (SPA auth code + PKCE);
# segredos como "client secret" NUNCA devem ir para o front-end.

# Application (client) ID do app registration no Microsoft Entra ID.
NG_APP_MSAL_CLIENT_ID=

# PRD FR-1: authority multi-tenant (endpoint 'common').
NG_APP_MSAL_AUTHORITY=https://login.microsoftonline.com/common

# URL de retorno registrada no app registration.
NG_APP_MSAL_REDIRECT_URI=http://localhost:4200

# URL base da API Spring Boot (application.yml -> server.port: 4040).
NG_APP_API_URL=http://localhost:4040