# Copie este arquivo para `.env` e preencha os valores:
#   cp .env.example .env
#
# `.env` é ignorado pelo git: nunca comite valores reais.

# Application (client) ID do app registration no Microsoft Entra ID.
NG_APP_MSAL_CLIENT_ID=seu-client-id-aqui

# Authority do tenant único da CPS (AD-3). Não use `common`: o app é single-tenant.
NG_APP_MSAL_AUTHORITY=https://login.microsoftonline.com/eabe64c5-68f5-4a76-8301-9577a679e449

# URL de retorno registrada no app registration. A barra final é obrigatória:
# divergir da registrada causa AADSTS50011.
NG_APP_MSAL_REDIRECT_URI=http://localhost:4200/

# URL base da API Spring Boot (application.yml -> server.port: 4040).
NG_APP_API_URL=http://localhost:4040
